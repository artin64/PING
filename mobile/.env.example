# For a physical phone, use your computer's LAN address (for example http://192.168.1.20:8000).
# Android emulator: http://10.0.2.2:8000
# iOS simulator and web on the same computer: http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
# Set after creating the Expo/EAS project to enable cross-device remote push registration.
EXPO_PUBLIC_EAS_PROJECT_ID=
