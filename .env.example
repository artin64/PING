# Local development defaults only. Replace these values for any shared or deployed environment.
PINGO_ENVIRONMENT=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
POSTGRES_USER=pingo
POSTGRES_PASSWORD=replace-this-local-password
POSTGRES_DB=pingo
PINGO_API_PASSWORD=replace-with-a-random-local-api-password
PINGO_WORKER_PASSWORD=replace-with-a-random-local-worker-password
# Use 0.0.0.0 for phone access over your trusted local Wi-Fi; localhost only otherwise.
PINGO_API_BIND_HOST=0.0.0.0
# Optional: use an existing managed PostgreSQL database, including Supabase.
# Create pingo_api and pingo_worker as separate NOBYPASSRLS roles first;
# keep all URLs server-only. Run Alembic with the migration-owner URL, pingo_api
# serves requests and pingo_worker dispatches notifications with scoped access.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# MIGRATIONS_DATABASE_URL=postgresql+psycopg://MIGRATION_ROLE:PASSWORD@HOST:5432/postgres?sslmode=require
# WORKER_DATABASE_URL=postgresql+psycopg://pingo_worker:PASSWORD@HOST:5432/postgres?sslmode=require
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Optional Expo Push Service access token. Configure FCM/APNs credentials in EAS for real devices.
EXPO_PUSH_ACCESS_TOKEN=
NOTIFICATION_POLL_SECONDS=10
AI_PROVIDER=none
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
GEMINI_MODEL=gemini-3.8-flash
# Keep empty unless you have server-side Gemini credentials and users opt in inside PINGO.
GEMINI_API_KEY=
